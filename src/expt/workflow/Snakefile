import os

wildcard_constraints:
    graph="er|sf",
    num_nodes=r"\d+",
    num_intervs=r"\d+",
    samp_size=r"\d+",
    seed=r"\d+",
    density=r"\d+\.\d+",
    lambda_pen=r"\d+\.\d+",
    noise="gaussian|uniform|laplace|t3|t4",
    targets_per_interv=r"\d+(to\d+)?",
    method="coarse|kpc1|kpc3|avg|repare",


include: "rules/common.smk"
include: "rules/pipeline.smk"
include: "rules/oracle.smk"
include: "rules/densities.smk"
include: "rules/scalability.smk"
include: "rules/noise.smk"
include: "rules/methods_compare.smk"
include: "rules/lambda_sens.smk"
include: "rules/threshold_correction.smk"
include: "rules/multitarget.smk"
include: "rules/highdim.smk"
include: "rules/causalchamber.smk"
include: "rules/perturbseq.smk"

# One BLAS thread per job: snakemake parallelism is across jobs, and oversubscribed
# BLAS pools make per-fit timings (and the runtime diagnostics) meaningless.
os.environ.setdefault("OMP_NUM_THREADS", "1")
os.environ.setdefault("OPENBLAS_NUM_THREADS", "1")
os.environ.setdefault("MKL_NUM_THREADS", "1")
os.environ.setdefault("NUMEXPR_NUM_THREADS", "1")


# Targets: densities_all, scalability_all, noise_all, methods_compare_all, lambda_sens_all,
# threshold_correction_all, multitarget_all, highdim_all, causalchamber, battery_all,
# rebuttal_all, coarse_all, all. Put targets before `--config`.
# Perturb-seq scaling ladder: `snakemake results/perturbseq-scaling-figure.pdf` builds
# every missing ladder leg and the figure; brace targets address individual panels,
# e.g. `snakemake results/perturbseq-cells-compare-{200,500}/summary.csv`.
rule coarse_all:
    input:
        rules.densities_all.input,
        rules.scalability_all.input,
        rules.noise_all.input,
        rules.lambda_sens_all.input,
        rules.threshold_correction_all.input,
        rules.highdim_all.input,


rule all:
    default_target: True
    input:
        rules.densities_all.input,
        rules.scalability_all.input,
        rules.noise_all.input,
        rules.methods_compare_all.input,
        rules.lambda_sens_all.input,
        rules.threshold_correction_all.input,
        rules.multitarget_all.input,
        rules.highdim_all.input,
        rules.causalchamber.input,


# Everything the new-experiments document quotes: the Perturb-seq ladder legs
# (summary + presentation table + diagnostics), the intervention-prediction table,
# the UT-IGSP tuning-grid artifact backing the stability claim, and the scaling
# figure. `snakemake new_expts` builds any missing pieces; the fits are CPU-heavy,
# so this target is deliberately separate from `all`.
rule new_expts:
    input:
        "results/perturbseq-scaling-figure.pdf",
        expand(
            "results/perturbseq-cells-compare-{panel}/{stem}",
            panel=["50", "100", "200", "500"],
            stem=[
                "summary.csv",
                "details.json",
                "table.csv",
                "table.tex",
                "diagnostics.csv",
                "utigsp_grid.csv",
            ],
        ),
        "results/perturbseq-shiftpred-table.tex",
