# Multi-target experiment: validates that COARSE, COARSE-CV and COARSE-1PC
# all recover the partition + DAG under intervention sets of size > 1. Three
# figure families (per-tpi line plots, headline summary, per-method 3-panel
# visualization). Sweep matrix defined in rules/multitarget.smk.
fig_multitarget = (
    expand(
        "results/multitarget/{graph}_p={p}_dens={d}_tpi={tpi}_{metric}.pdf",
        graph=["er"],
        p=[10, 20, 50],
        d=[0.2, 0.5],
        tpi=["2", "3", "5", "1to5"],
        metric=["fscore", "ari", "runtime_sec"],
    )
    + expand(
        "results/multitarget/summary_{metric}.pdf",
        metric=["fscore", "ari"],
    )
    + [
        "results/multitarget/viz/coarse_multitarget.pdf",
        "results/multitarget/viz/cv_multitarget.pdf",
        "results/multitarget/viz/onepc_multitarget.pdf",
    ]
)
