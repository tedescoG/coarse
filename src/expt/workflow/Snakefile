# Global wildcard constraints, declared once before any include so every rule shares them.
wildcard_constraints:
    graph="er|sf",
    num_nodes=r"\d+",
    num_intervs=r"\d+",
    samp_size=r"\d+",
    seed=r"\d+",
    density=r"\d+\.\d+",
    lambda_pen=r"\d+\.\d+",
    noise="gaussian|uniform|laplace",
    targets_per_interv=r"\d+(to\d+)?",
    method="coarse|cv|onepc|kpc1|kpc3|repare",


# Shared templates and per-cell rules first, then collect+plot experiment files.
include: "rules/common.smk"
include: "rules/pipeline.smk"
include: "rules/oracle.smk"
include: "rules/synth.smk"
include: "rules/multitarget.smk"
include: "rules/noise.smk"
include: "rules/kpc.smk"
include: "rules/lambda.smk"
include: "rules/methods_compare.smk"
include: "rules/causalchamber.smk"


# Convenience targets, one per experiment (e.g. `snakemake exp2 --cores all`): synth_main,
# synth_scalability, synth_all, noise_all, exp2, exp3, lambda_samp, lambda_density,
# lambda_all, methods_compare_all, multitarget_all, causalchamber. `--config smoke=1`
# shrinks every synthetic grid (see rules/common.smk).
rule all:
    default_target: True
    input:
        rules.synth_all.input,
        rules.noise_all.input,
        rules.exp2.input,
        rules.exp3.input,
        rules.lambda_all.input,
        rules.methods_compare_all.input,
        rules.multitarget_all.input,
        rules.causalchamber.input,
